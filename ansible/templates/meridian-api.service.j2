[Unit]
Description=Meridian FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ meridian_runtime_user }}
Group={{ meridian_runtime_user }}
WorkingDirectory={{ meridian_backend_root }}
EnvironmentFile={{ meridian_app_root }}/config/meridian.env
ExecStart={{ meridian_backend_venv }}/bin/uvicorn app.main:app --app-dir {{ meridian_backend_root }} --host {{ meridian_api_host }} --port {{ meridian_app_port }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
