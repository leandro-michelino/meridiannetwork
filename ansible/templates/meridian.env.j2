MERIDIAN_APP_NAME=Meridian API
MERIDIAN_APP_VERSION=0.1.0
MERIDIAN_DEPLOYMENT_REVISION={{ meridian_deploy_revision | default('local') }}
MERIDIAN_DEPLOYMENT_BUILT_AT={{ meridian_deploy_built_at | default('') }}
MERIDIAN_DEPLOYMENT_DIRTY={{ meridian_deploy_dirty | default(false) | ternary('true', 'false') }}
MERIDIAN_ENVIRONMENT={{ meridian_environment }}
MERIDIAN_API_HOST={{ meridian_api_host }}
MERIDIAN_API_PORT={{ meridian_app_port }}

MERIDIAN_HOME_REGION={{ meridian_home_region }}
MERIDIAN_ACTIVE_REGIONS={{ meridian_active_regions.split(',') | map('trim') | select | list | tojson }}
MERIDIAN_COMPARTMENT_IDS={{ meridian_compartment_ids.split(',') | map('trim') | select | list | tojson if meridian_compartment_ids else '[]' }}
MERIDIAN_TENANCY_OCID={{ meridian_effective_tenancy_ocid | default(meridian_tenancy_ocid) }}

MERIDIAN_OCI_AUTH={{ meridian_oci_auth }}
MERIDIAN_OCI_PROFILE={{ meridian_oci_profile | default('DEFAULT') }}
MERIDIAN_ENABLE_LIVE_OCI={{ meridian_enable_live_oci }}
MERIDIAN_ENABLE_RESOURCE_SEARCH_SCOPE={{ meridian_enable_resource_search_scope | default('true') }}

MERIDIAN_INVENTORY_CACHE_TTL_SECONDS={{ meridian_inventory_cache_ttl | default(30) }}
MERIDIAN_INVENTORY_SNAPSHOT_TTL_SECONDS={{ meridian_inventory_snapshot_ttl | default(900) }}
MERIDIAN_INVENTORY_SNAPSHOT_DIR={{ meridian_inventory_snapshot_dir | default(meridian_app_root + '/data/snapshots') }}

MERIDIAN_SECURITY_ACTION_OBJECT_STORAGE_ENABLED={{ meridian_security_action_object_storage_enabled | default('false') }}
MERIDIAN_SECURITY_ACTION_OBJECT_STORAGE_NAMESPACE={{ meridian_security_action_object_storage_namespace | default('') }}
MERIDIAN_SECURITY_ACTION_OBJECT_STORAGE_BUCKET={{ meridian_security_action_object_storage_bucket | default('') }}
MERIDIAN_SECURITY_ACTION_OBJECT_STORAGE_PREFIX={{ meridian_security_action_object_storage_prefix | default('meridian/security-actions/') }}
MERIDIAN_SECURITY_ACTION_RETENTION_DAYS={{ meridian_security_action_retention_days | default(365) }}

MERIDIAN_TRAFFIC_FLOW_LOGS_ENABLEMENT_ALLOWED={{ meridian_traffic_flow_logs_enablement_allowed | default('false') }}
MERIDIAN_TRAFFIC_FLOW_LOGS_LOG_GROUP_NAME={{ meridian_traffic_flow_logs_log_group_name | default('meridian-traffic-flow-logs') }}
MERIDIAN_TRAFFIC_FLOW_LOGS_CAPTURE_FILTER_NAME={{ meridian_traffic_flow_logs_capture_filter_name | default('meridian-traffic-capture-filter') }}
MERIDIAN_TRAFFIC_FLOW_LOGS_LOG_NAME_PREFIX={{ meridian_traffic_flow_logs_log_name_prefix | default('meridian-flow') }}
MERIDIAN_TRAFFIC_FLOW_LOGS_DEFAULT_LOOKBACK_MINUTES={{ meridian_traffic_flow_logs_default_lookback_minutes | default(60) }}
MERIDIAN_TRAFFIC_FLOW_LOGS_MAX_LOOKBACK_HOURS={{ meridian_traffic_flow_logs_max_lookback_hours | default(24) }}
MERIDIAN_TRAFFIC_FLOW_LOGS_SEARCH_LIMIT={{ meridian_traffic_flow_logs_search_limit | default(100) }}
