# Example only. Rename to backend.tf after choosing and testing a backend.
#
# Terraform has no first-class OCI backend. For OCI Object Storage, one common
# approach is the S3-compatible backend. Configure endpoints and credentials
# according to your tenancy standards before enabling this.
#
# terraform {
#   backend "s3" {
#     bucket                      = "meridian-terraform-state"
#     key                         = "dev/terraform.tfstate"
#     region                      = "eu-frankfurt-1"
#     endpoint                    = "https://<namespace>.compat.objectstorage.<region>.oraclecloud.com"
#     skip_region_validation      = true
#     skip_credentials_validation = true
#     skip_metadata_api_check     = true
#     force_path_style            = true
#   }
# }

